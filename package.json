{
  "name": "dsh-web-search-opencode-ds",
  "version": "0.2.0",
  "description": "把 OpenCode 作为 DeepSeek Harness 的网页搜索提供方：经 OpenCode 的 Anthropic 兼容 Messages 接口调用 DeepSeek 的服务端 web_search，并自带设置页。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/*",
    "test/*",
    "pnpm-lock.yaml"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "web-search",
    "opencode",
    "opencode-go",
    "deepseek",
    "anthropic-messages",
    "web_search_20250305"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-web-search-opencode-ds.git"
  },
  "homepage": "https://github.com/lldwb/dsh-web-search-opencode-ds#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-web-search-opencode-ds/issues"
  },
  "meta": {
    "title": "网页搜索（OpenCode / DeepSeek）",
    "description": "注册 opencode-ds 搜索提供商，经 OpenCode 调用 DeepSeek 官方的服务端 web_search，并自带设置页。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
